      "name": "词表导入与词库整合",
      "summary": "把 12 份人教版教材词表（约 3310 词条）导入为标准化词库，按文本一致性合并释义来源（一致则合并、不同则拆为独立义项），并为每个义项生成五维内容占位。是整条生产流水线的数据源头。",
      "tags": [
        "import",
        "vocabulary",
        "data-ingestion",
        "merge"
      ],
      "complexity": "complex",
      "domainMeta": {
        "entities": [
          "Package",
          "PackageWord",
          "Word",
          "WordMeaning",
          "ContentItem"
        ],
        "businessRules": [
          "释义文本一致→合并来源；不同→独立义项",
          "上传文件需魔数校验防伪造",
          "导入后为每个义项生成五维内容占位"
        ],
        "crossDomainInteractions": [
          "导入完成后触发内容生成域",
          "词包归入词包与生产编排域管理"
        ]
      }
    },
    {
      "id": "domain:content-generation",
      "type": "domain",
      "name": "五维内容生成",
