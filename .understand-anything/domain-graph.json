          "ContentItem"
        ],
        "businessRules": [
          "Layer1 算法规则先行，Layer2 AI 语义校验在后",
          "质检规则按维度经装饰器自注册到 RuleRegistry",
          "Layer2 AI 调用带并发信号量+熔断器+指数退避",
