          "AiTaskQueue",
          "Prompt"
        ],
        "businessRules": [
          "内容按义项挂载，助记含 4 种策略子类",
          "AI 调用受熔断器保护，连续失败快速熔断",
          "支持直连并发与网关异步轮询两条执行路径",
          "词根词缀助记需注入词素知识库"
        ],
        "crossDomainInteractions": [
          "消费导入域产出的内容占位",
          "生成结果进入质检域",
