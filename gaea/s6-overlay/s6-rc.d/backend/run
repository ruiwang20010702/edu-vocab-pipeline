#!/command/with-contenv sh
# backend (longrun): gunicorn + uvicorn worker
# 绑定到 127.0.0.1 仅供容器内 nginx 访问
# GUNICORN_WORKERS 环境变量控制 worker 数量（默认 2）
cd /app || exit 1
exec gunicorn \
    -w "${GUNICORN_WORKERS:-4}" \
    -k uvicorn.workers.UvicornWorker \
    --bind 127.0.0.1:8000 \
    --timeout 120 \
    --access-logfile /dev/null \
    --error-logfile - \
    --log-level info \
    vocab_qc.api.main:app
