# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，切勿提交）
# 钉钉企业内部应用凭证（控制台「基础信息」获取，AppSecret 是密钥）
DINGTALK_APP_KEY=your_app_key
DINGTALK_APP_SECRET=your_app_secret

# 51talk AI Gateway（任务4接入 AI 时填）
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=gemini-3-flash-preview|efficiency
AI_GATEWAY_BIZ_TYPE=vocab_qc_bot

# 问答日志落盘路径
BOT_LOG_PATH=./bot_qa.log
